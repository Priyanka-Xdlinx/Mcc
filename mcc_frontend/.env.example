# Every value has a default; copy to .env only to override one.

# Base URL for REST and auth calls. Empty (the default) means the same origin:
# the Vite proxy in development, the backend itself in a production build.
VITE_API_BASE_URL=

# How long any one request may take before it is abandoned, in milliseconds.
VITE_REQUEST_TIMEOUT_MS=15000

# Whether logger.log/info/debug reach the console (warn and error always do).
VITE_ENABLE_CONSOLE_LOGS=

# Dev server only: where the Vite proxy sends /api, /auth, /ws and Swagger.
# MCC_BACKEND=http://localhost:8080
