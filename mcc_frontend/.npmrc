# @vitejs/plugin-react 6 pulls @rolldown/plugin-babel, whose optional peer
# wants @babel/core 8, while the Jest setup (@babel/preset-env/react) wants
# @babel/core 7. Both can coexist in the tree; only npm's strict peer check
# objects. Setting this in the project rather than passing a flag keeps
# `npm install` and `npm ci` resolving identically, here and in CI.
legacy-peer-deps=true
